# Keep Linux (LF) line endings everywhere: the chaincode is built and run
# inside Ubuntu (WSL) and Fabric's Docker containers, where CRLF breaks
# shell scripts and gofmt reports CRLF-formatted Go files.
* text=auto eol=lf

# Windows scripts keep Windows line endings.
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.docx binary
*.tar.gz binary
